# Version control
.git
.gitignore

# Environment files — never bake secrets into the image
.env
.env.*
*.env

# Development tooling and docs
# (docs/swagger/ is real Go source generated code that main.go imports — keep it)
docs/architecture/
docs/lld/
deploy/
scripts/
*.md
ARCHITECTURE.md
README.md

# Test artefacts
test/
coverage.out
coverage.html
*.coverprofile
.coverage/

# Build artefacts already compiled outside Docker
bin/

# IDE and OS noise
.idea/
.vscode/
*.DS_Store
*.swp
*.swo

# Go tool cache (not needed in image)
vendor/
