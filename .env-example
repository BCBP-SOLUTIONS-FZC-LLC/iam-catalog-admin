# Catalog / Admin Config Service — environment variables.
# Pruned from iam-org-membership's .env-example: no outbox/SNS/SQS/Glue
# vars (this service has no events, LLD §10), no RLS/GUC vars (no tenant
# context, LLD §9).

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=catalog-admin-config
APP_PORT=8081
BUILD_VERSION=dev
DOCS_ENABLED=false

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Either DATABASE_URL, or the PG_* parts below.
# DATABASE_URL=postgres://catalog_admin_app:password@localhost:5535/catalog_admin?sslmode=disable
PG_HOST=localhost
PG_PORT=5535
PG_USER=catalog_admin_app
PG_PASSWORD=changeme
PG_DBNAME=catalog_admin
PG_SSLMODE=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=0
PG_BOUNCER_MODE=false
# MIGRATION_DATABASE_URL=postgres://catalog_admin_app:password@localhost:5535/catalog_admin?sslmode=disable

# ── Valkey / Redis ────────────────────────────────────────────────────────
# Local port offset from sibling services (iam-org-membership uses 6380) so
# both can run in parallel during local dev.
VALKEY_URL=localhost:6381

# ── OpenTelemetry (opt-in) ────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
