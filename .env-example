# Catalog / Admin Config Service — environment variables.
# Pruned from iam-org-membership's .env-example: no outbox/SNS/SQS/Glue
# vars (this service has no events, LLD §7), no RLS/GUC vars (no tenant
# context, LLD §10).

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=catalog-admin-config
APP_PORT=8081
# /metrics is served on its own dedicated port/listener, separate from
# APP_PORT — see cmd/catalog-admin-config/main.go's metricsServer.
METRICS_PORT=9090
BUILD_VERSION=dev
DOCS_ENABLED=false

# cat:departments/cat:plans cache TTL (LLD §6/§12) — externalized, not a
# compiled constant.
CATALOG_TTL_SECONDS=60

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Either DATABASE_URL, or the PG_* parts below.
# DATABASE_URL=postgres://catalog_admin_app:password@localhost:5535/catalog_admin?sslmode=disable
PG_HOST=localhost
PG_PORT=5535
PG_USER=catalog_admin_app
PG_PASSWORD=changeme
PG_DBNAME=catalog_admin
PG_SSLMODE=disable
PG_MAX_CONNS=10
# PG_MIN_CONNS intentionally omitted — pgcommon.ConfigFromEnv rejects "0"
# as non-positive and falls back to its own default (2) with a startup
# warning; leave unset to use that default rather than fighting it.
PG_BOUNCER_MODE=false
# MIGRATION_DATABASE_URL=postgres://catalog_admin_app:password@localhost:5535/catalog_admin?sslmode=disable

# ── Valkey / Redis ────────────────────────────────────────────────────────
# Local port offset from sibling services (iam-org-membership uses 6380) so
# both can run in parallel during local dev.
VALKEY_URL=localhost:6381

# ── OpenTelemetry ─────────────────────────────────────────────────────────
# Provider is always installed (in-process spans get valid IDs even
# without a collector). Export is a no-op until this is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
